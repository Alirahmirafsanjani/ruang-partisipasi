# ============================================================
# RUANG PARTISIPASI — CONTOH ENVIRONMENT VARIABLES
# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN pernah commit file `.env` ke GitHub.
# ============================================================

# --- Hanya untuk Netlify Functions (RAHASIA, jangan pakai prefix VITE_) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ID kegiatan. Harus sama dengan EVENT_ID di netlify/functions/_shared/config.ts
EVENT_ID=
# Prefix nomor sertifikat, contoh: SI
CERTIFICATE_PREFIX=

# Token pemulihan sertifikat (opsional, tapi disarankan).
# Dipakai oleh operator lewat header x-recovery-token pada function recover-certificate.
CERTIFICATE_RECOVERY_TOKEN=

# --- Sumber data peserta: Google Sheets PRIVATE (RAHASIA) ---
# Jika ketiga variabel di bawah diisi, daftar peserta diambil dari Sheets.
# Jika kosong, aplikasi memakai daftar fallback di _shared/config.ts.
# Sheet harus di-share (Viewer) ke service account email di bawah.
# Sheet HANYA berisi daftar NIM di kolom A (format Plain text).
# Nama lengkap tidak diambil dari sheet; peserta mengetiknya sendiri di aplikasi.
GOOGLE_SHEET_ID=
# Nama tab dan rentang, contoh: Peserta!A:A
GOOGLE_SHEET_RANGE=Peserta!A:A
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Salin private_key dari file JSON service account.
# Boleh pakai \n literal untuk newline, misalnya:
# "-----BEGIN PRIVATE KEY-----\nABC...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Aman untuk frontend (diawali VITE_, akan ikut di bundle browser) ---
# Ini hanya teks awal saat halaman memuat; nilai final tetap diambil dari
# get-event-config (backend). Bukan rahasia.
VITE_EVENT_TITLE=
VITE_EVENT_SUBTITLE=
VITE_EVENT_DATE=
VITE_EVENT_ORGANIZER=
